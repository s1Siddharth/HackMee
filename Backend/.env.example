# Option 1: NVIDIA API Key (Official NVIDIA NIM / AI Foundation)
# Get key from: https://build.nvidia.com
# NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Option 2: OpenRouter (Access to 120B Nemotron, MiniMax, Gemma, 550B)
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_1=minimax/minimax-m3:free
OPENROUTER_FALLBACK_2=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_3=nvidia/nemotron-3-ultra-550b-a55b:free

# Option 3: Groq (Direct ultra-fast Groq API)
# Get key from: https://console.groq.com/keys
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
